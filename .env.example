SEI_BASE_URL=https://www.sei.mg.gov.br
SEI_USUARIO=seu_cpf
SEI_SENHA=sua_senha
SEI_ORGAO=CBMMG
HEADLESS=true
NAV_TIMEOUT_MS=30000
POOL_SIZE=2
LER_IMAGENS=false

# /processos/consultar também cria um documento com o texto da IA (o fluxo completo é /oficios/responder)
CRIAR_DOCUMENTO=false
TIPO_DOCUMENTO_PADRAO=Ofício

# OpenAI (sem chave = texto simulado)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT_S=120
# proxy corporativo, ex.: http://proxy.prodemge.gov.br:8080
OPENAI_PROXY=
IA_MAX_CARACTERES=100000

# cadastros e despacho
DADOSMIL_PATH=dados/dadosmil.json
AUTORIDADES_PATH=dados/autoridades.json
ETIQUETAS_PATH=dados/etiquetas.json
DESPACHO_ASSINATURA=Cap Cleyton
DESPACHO_MAX_CARACTERES=250
